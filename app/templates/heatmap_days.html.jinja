{% extends "base.html.jinja" %}
{% block title %}Heatmap Days{% endblock %}
{% block css %}
  <link rel="stylesheet" href="../static/css/style.css">
  <link rel="stylesheet" href="../static/css/heatmap.css">
{% endblock %}
{% block body %}
  <body>
    {% include "snippets/header.html.jinja" %}
    <div class="header">
      <h1 class="header-title">Create Event</h1>
      <div class="steps">
        <div class="step">
          <div class="step-circle">✓</div>
          <span class="step-label">Details</span>
        </div>
        <div class="step-line done"></div>
        <div class="step">
          <div class="step-circle">✓</div>
          <span class="step-label">Availability</span>
        </div>
        <div class="step-line"></div>
        <div class="step">
          <div class="step-circle pending">3</div>
          <span class="step-label">Invite</span>
        </div>
      </div>
      <div class="event-label">📅 My Event</div>
    </div>

    <div class="content">
      <div class="calendar-card">
        <div id="calendar"></div>
      </div>
      <aside class="side-panels">
        <div class="side-panel" id="popular-panel">
          <p class="side-panel-label">most popular</p>
          <p id="popular-value" class="side-panel-value">—</p>
          <p id="popular-count" class="side-panel-sub"></p>
        </div>
        <div class="side-panel" id="share-panel">
          <p class="side-panel-label">share code</p>
          <p id="share-code" class="share-code"></p>
          <button class="copy-btn" onclick="copyCode()">copy</button>
        </div>
        <div class="side-panel hover-panel" id="hover-panel">
          <p class="side-panel-label">available</p>
          <p id="panel-title" class="side-panel-value">—</p>
          <ul id="panel-list" class="panel-list"></ul>
        </div>
      </aside>
    </div>

    <script src="../static/javascript/heatmap_days.js"></script>
  </body>
{% endblock %}