{% extends "base.html.jinja" %}
{% block title %}Heatmap – Times{% endblock %}
{% block body_class %}heatmap-times-page{% endblock %}

{% block extra_head %}
  <link rel="stylesheet" href="{{ url_for('static', filename='css/heatmap.css') }}">
{% endblock %}

{% block body %}
  <div class="header">
    <h1 class="header-title">Create Event</h1>
    <div class="steps">
      <div class="step">
        <div class="step-circle">✓</div>
        <span class="step-label">Details</span>
      </div>
      <div class="step-line done"></div>
      <div class="step">
        <div class="step-circle">2</div>
        <span class="step-label">Availability</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <div class="step-circle pending">3</div>
        <span class="step-label">Invite</span>
      </div>
    </div>
    <div class="event-label">📅 {{ event.name }}</div>
  </div>

  <div class="content">
    <div class="calendar-card">
      <div id="grid" class="time-grid"></div>
    </div>
    <aside class="side-panels">
      <div class="side-panel">
        <button class="copy-btn" onclick="goToInvite()">Next: Invite →</button>
      </div>
      <div class="side-panel" id="popular-panel">
        <p class="side-panel-label">most popular</p>
        <p id="popular-value" class="side-panel-value">—</p>
        <p id="popular-count" class="side-panel-sub"></p>
      </div>
      <div class="side-panel hover-panel" id="hover-panel">
        <p class="side-panel-label">available</p>
        <p id="panel-title" class="side-panel-value">—</p>
        <ul id="panel-list" class="panel-list"></ul>
      </div>
    </aside>
  </div>
{% endblock %}

{% block scripts %}
  <script>
    const EVENT_NAME      = {{ event.name      | tojson }};
    const EVENT_DAYS      = {{ event.days      | tojson }};
    const EVENT_TIME_FROM = {{ event.time_from | tojson }};
    const EVENT_TIME_TO   = {{ event.time_to   | tojson }};

    function goToInvite() {
      const params = new URLSearchParams({
        name:     EVENT_NAME,
        type:     'week',
        days:     EVENT_DAYS,
        timeFrom: EVENT_TIME_FROM,
        timeTo:   EVENT_TIME_TO
      });
      window.location.href = '/event/code?' + params.toString();
    }
  </script>
  <script src="{{ url_for('static', filename='javascript/heatmap_times.js') }}"></script>
{% endblock %}