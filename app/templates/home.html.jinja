{% extends "base.html.jinja" %}
{% block title %}Home{% endblock %}
{% block body_class %}home-page{% endblock %}

{% block body %}
<div class="home-page-wrap">
    {% include "snippets/header.html.jinja" %}

        <!-- NAV TABS -->
        <div class="home-nav-tabs">
            <button class="nav-tab active" onclick="switchTab(this, 'tab-events')">My Events</button>
            <button class="nav-tab" onclick="switchTab(this, 'tab-calendar')">My Calendar</button>
            <button class="nav-tab" onclick="switchTab(this, 'tab-join')">Join Event</button>
        </div>

        <!-- CONTENT -->
        <div class="home-content">

            <!-- MY EVENTS TAB -->
            <div id="tab-events" class="tab-content active">
                <div class="events-panel">
                    <div class="panel-title">Upcoming Events</div>
                    {% if events %}
                        {% for event in events %}
                        <div class="event-card">
                            <!-- left side: click to open heatmap -->
                            <a href="/event/{{ event.id }}/heatmap" class="event-card-link">
                                <div class="event-card-name">{{ event.name }}</div>
                                <div class="event-card-sub">
                                    {{ event.event_type }} · {{ event.members|length }} respondents · Waiting...
                                </div>
                            </a>

                            <!-- right side: owner deletes, member leaves -->
                            {% if event.organizer_id == current_user.id %}
                                <form method="POST" action="/event/{{ event.id }}/delete"
                                      onsubmit="return confirm('Delete {{ event.name }}? This removes it for everyone.')">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <button type="submit" class="event-action-btn delete">Delete</button>
                                </form>
                            {% else %}
                                <form method="POST" action="/event/{{ event.id }}/leave"
                                      onsubmit="return confirm('Leave {{ event.name }}?')">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <button type="submit" class="event-action-btn leave">Leave</button>
                                </form>
                            {% endif %}
                        </div>
                        {% endfor %}
                    {% else %}
                        <p class="no-events">You have no upcoming events. Create one below!</p>
                    {% endif %}
                </div>
            </div>

            <!-- MY CALENDAR TAB -->
            <div id="tab-calendar" class="tab-content">
                <div class="mini-calendar">
                    <div class="cal-nav">
                        <button class="cal-nav-btn" onclick="calNav(-1)">‹</button>
                        <span class="cal-month" id="cal-month-label"></span>
                        <button class="cal-nav-btn" onclick="calNav(1)">›</button>
                    </div>
                    <div class="cal-grid" id="cal-grid"></div>
                </div>
            </div>

            <!-- JOIN EVENT TAB -->
            <div id="tab-join" class="tab-content">
                <div class="events-panel">
                    <div class="panel-title">Join an Event</div>
                    <p class="join-instructions">Enter the 6-character code shared by your event organiser.</p>

                    <!-- real form — POSTs to /event/join server-side -->
                    <form method="POST" action="/event/join">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <input id="join-code-input" name="code" class="input-field join-code-field"
                               maxlength="6" placeholder="ABC123" autocomplete="off" spellcheck="false" />
                        {% if join_error %}
                            <div class="join-feedback error">{{ join_error }}</div>
                        {% endif %}
                        <button id="join-event-button" type="submit" class="btn-primary">Join Event</button>
                    </form>
                </div>
            </div>

        </div>

        <!-- BOTTOM ACTIONS -->
        <div class="bottom-actions">
            <button id="create-event-button" class="btn-primary" onclick="window.location.href='{{ create_event_url }}'">Create New Event +</button>
        </div>

</div>
{% endblock %}

{% block scripts %}
    <script src="{{ url_for('static', filename='javascript/home.js') }}"></script>
{% endblock %}
